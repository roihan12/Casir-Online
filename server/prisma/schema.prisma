generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DIRECT_URL")
  // directUrl = env("DIRECT_URL")
}

model Cabang {
  id                  String               @id @map("cabang_id")
  namaCabang          String               @map("nama_cabang") @db.VarChar(100)
  alamat              String?
  telepon             String?              @db.VarChar(20)
  latitude            Decimal?             @db.Decimal(10, 8)
  longitude           Decimal?             @db.Decimal(11, 8)
  radiusGeofence      Int?                 @map("radius_geofence")
  status              CabangStatus         @default(aktif)
  deletedAt           DateTime?            @map("deleted_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  InventoryMovement   InventoryMovement[]
  NotificationConfig  NotificationConfig[]
  Pelanggan           Pelanggan[]
  produk              Produk[]
  ProdukPriceHistory  ProdukPriceHistory[]
  ProdukRequest       ProdukRequest[]
  promoDiskon         PromoDiskon[]
  ReceiptConfig       ReceiptConfig[]
  shifts              Shift[]
  StockNotification   StockNotification[]
  stockTransferAsal   StockTransfer[]      @relation("CabangAsal")
  stockTransferTujuan StockTransfer[]      @relation("CabangTujuan")
  Supplier            Supplier[]
  TaxConfig           TaxConfig?
  Transaksi           Transaksi[]
  userCabang          UserCabang[]
  userRoles           UserRole[]
  marketingCampaigns  MarketingCampaign[]
  hutang              Hutang[]
  operationalHours    OperationalHours[]
  BotConfig           BotConfig[]
  ProdukSupplier      ProdukSupplier[]
  loyaltyConfig       LoyaltyConfig[]
  absensiPegawai      AbsensiPegawai[]
  userLokasiAbsensi   UserLokasiAbsensi[]
  jadwalKerja         JadwalKerja[]
  lokasiAbsensi       LokasiAbsensi[]

  @@map("cabang")
}

model User {
  id                String              @id @default(uuid()) @map("user_id")
  username          String              @unique @db.VarChar(50)
  password          String              @db.VarChar(255)
  namaLengkap       String              @map("nama_lengkap") @db.VarChar(100)
  email             String              @db.VarChar(100)
  telepon           String?             @db.VarChar(20)
  avatarUrl         String?             @map("avatar_url") @db.VarChar(255)
  // Face Recognition Data
  faceImageUrl      String?             @map("face_image_url") @db.VarChar(255) // URL foto wajah untuk referensi face recognition
  faceDataJson      String?             @map("face_data_json") @db.Text // Data wajah dalam format JSON untuk face recognition
  faceRecognitionEnabled Boolean         @default(false) @map("face_recognition_enabled") // Flag apakah user menggunakan face recognition
  lastFaceUpdate    DateTime?           @map("last_face_update") // Kapan terakhir data wajah diperbarui
  status            UserStatus          @default(aktif)
  deletedAt         DateTime?           @map("deleted_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  lastLogin         DateTime?           @map("last_login")
  createdBy         String?             @map("created_by")
  updatedBy         String?             @map("updated_by")
  createdByUserId   String?             @map("created_by_user_id")
  updatedByUserId   String?             @map("updated_by_user_id")
  deletedBy         String?             @map("deleted_by")
  deletedByUserId   String?             @map("deleted_by_user_id")
  inventoryMovement InventoryMovement[]

  requestsApproved ProdukRequest[] @relation("requestApproved")

  // Stock transfer approval relation
  stockTransfersApproved StockTransfer[] @relation("ApproverUser")

  ProdukRequestAttachment ProdukRequestAttachment[]
  shifts                  Shift[]
  absensi                 AbsensiPegawai[]
  jadwalKerja             JadwalKerja[]

  userCabang       UserCabang[]
  userRoles        UserRole[]
  sessions         UserSession[]
  approvedCredits  KreditSetting[]    @relation("ApprovedCredit")
  pembayaranHutang PembayaranHutang[]

  // Audit trail relations
  produkCreated Produk[] @relation("ProdukCreatedByUserId")
  produkUpdated Produk[] @relation("ProdukUpdatedByUserId")
  produkDeleted Produk[] @relation("ProdukDeletedByUserId")

  pelangganCreated Pelanggan[] @relation("PelangganCreatedByUserId")
  pelangganUpdated Pelanggan[] @relation("PelangganUpdatedByUserId")
  pelangganDeleted Pelanggan[] @relation("PelangganDeletedByUserId")

  transaksiCreated Transaksi[] @relation("TransaksiCreatedByUserId")
  transaksiUpdated Transaksi[] @relation("TransaksiUpdatedByUserId")
  transaksiDeleted Transaksi[] @relation("TransaksiDeletedByUserId")

  kategoriCreated Kategori[] @relation("KategoriCreatedByUserId")
  kategoriUpdated Kategori[] @relation("KategoriUpdatedByUserId")
  kategoriDeleted Kategori[] @relation("KategoriDeletedByUserId")

  produkMasterCreated ProdukMaster[] @relation("ProdukMasterCreatedByUserId")
  produkMasterUpdated ProdukMaster[] @relation("ProdukMasterUpdatedByUserId")
  produkMasterDeleted ProdukMaster[] @relation("ProdukMasterDeletedByUserId")

  supplierCreated    Supplier[]    @relation("SupplierCreatedByUserId")
  supplierUpdated    Supplier[]    @relation("SupplierUpdatedByUserId")
  supplierDeleted    Supplier[]    @relation("SupplierDeletedByUserId")
  PromoDiskonCreated PromoDiskon[] @relation("PromoDiskonCreatedByUserId")
  PromoDiskonDeleted PromoDiskon[] @relation("PromoDiskonDeletedByUserId")
  PromoDiskonUpdated PromoDiskon[] @relation("PromoDiskonUpdatedByUserId")
  // Audit trail relations - Shift
  shiftCreated       Shift[]       @relation("ShiftCreatedByUserId")
  shiftUpdated       Shift[]       @relation("ShiftUpdatedByUserId")
  shiftDeleted       Shift[]       @relation("ShiftDeletedByUserId")

  // Audit trail relations - ProdukSupplier
  produkSupplierCreated ProdukSupplier[] @relation("ProdukSupplierCreatedByUserId")
  produkSupplierUpdated ProdukSupplier[] @relation("ProdukSupplierUpdatedByUserId")
  produkSupplierDeleted ProdukSupplier[] @relation("ProdukSupplierDeletedByUserId")

  // Audit trail relations - ProdukPriceHistory
  produkPriceHistoryCreated ProdukPriceHistory[] @relation("ProdukPriceHistoryCreatedByUserId")
  produkPriceHistoryUpdated ProdukPriceHistory[] @relation("ProdukPriceHistoryUpdatedByUserId")
  produkPriceHistoryDeleted ProdukPriceHistory[] @relation("ProdukPriceHistoryDeletedByUserId")

  // Audit trail relations - StockTransfer
  stockTransferCreated StockTransfer[] @relation("StockTransferCreatedByUserId")
  stockTransferUpdated StockTransfer[] @relation("StockTransferUpdatedByUserId")
  stockTransferDeleted StockTransfer[] @relation("StockTransferDeletedByUserId")

  // Audit trail relations - Pembayaran
  pembayaranCreated Pembayaran[] @relation("PembayaranCreatedByUserId")
  pembayaranUpdated Pembayaran[] @relation("PembayaranUpdatedByUserId")
  pembayaranDeleted Pembayaran[] @relation("PembayaranDeletedByUserId")
  AuditLog          AuditLog[]

  // Audit trail relations - MarketingCampaign
  marketingCampaignCreated MarketingCampaign[] @relation("MarketingCampaignCreatedByUserId")
  marketingCampaignUpdated MarketingCampaign[] @relation("MarketingCampaignUpdatedByUserId")
  marketingCampaignDeleted MarketingCampaign[] @relation("MarketingCampaignDeletedByUserId")

  // Audit trail relations - MarketingContent
  marketingContentCreated MarketingContent[] @relation("MarketingContentCreatedByUserId")
  marketingContentUpdated MarketingContent[] @relation("MarketingContentUpdatedByUserId")
  marketingContentDeleted MarketingContent[] @relation("MarketingContentDeletedByUserId")
  // Audit trail relations - Hutang
  hutangCreated           Hutang[]           @relation("HutangCreatedByUserId")
  hutangUpdated           Hutang[]           @relation("HutangUpdatedByUserId")
  hutangDeleted           Hutang[]           @relation("HutangDeletedByUserId")

  // Audit trail relations - PembayaranHutang
  pembayaranHutangCreated PembayaranHutang[] @relation("PembayaranHutangCreatedByUserId")
  pembayaranHutangUpdated PembayaranHutang[] @relation("PembayaranHutangUpdatedByUserId")
  pembayaranHutangDeleted PembayaranHutang[] @relation("PembayaranHutangDeletedByUserId")
  // Audit trail relations - KreditSetting
  kreditSettingCreated    KreditSetting[]    @relation("KreditSettingCreatedByUserId")
  kreditSettingUpdated    KreditSetting[]    @relation("KreditSettingUpdatedByUserId")
  kreditSettingDeleted    KreditSetting[]    @relation("KreditSettingDeletedByUserId")

  // Audit trail relations - KreditTransaksi
  kreditTransaksiCreated  KreditTransaksi[]  @relation("KreditTransaksiCreatedByUserId")
  kreditTransaksiUpdated  KreditTransaksi[]  @relation("KreditTransaksiUpdatedByUserId")
  kreditTransaksiDeleted  KreditTransaksi[]  @relation("KreditTransaksiDeletedByUserId")
  // Audit trail relations - PembayaranKredit
  pembayaranKreditCreated PembayaranKredit[] @relation("PembayaranKreditCreatedByUserId")
  pembayaranKreditUpdated PembayaranKredit[] @relation("PembayaranKreditUpdatedByUserId")
  pembayaranKreditDeleted PembayaranKredit[] @relation("PembayaranKreditDeletedByUserId")

  // Audit trail relations - ProdukRequest
  produkRequestCreated ProdukRequest[] @relation("ProdukRequestCreatedByUserId")
  produkRequestUpdated ProdukRequest[] @relation("ProdukRequestUpdatedByUserId")
  produkRequestDeleted ProdukRequest[] @relation("ProdukRequestDeletedByUserId")
  StockTransfer        StockTransfer[]

  approvedKreditRekomendasi KreditRekomendasi[] @relation("ApprovedKreditRekomendasi")
  
  // Add these audit trail relations
  kreditRekomendasiCreated KreditRekomendasi[] @relation("KreditRekomendasiCreatedByUserId")
  kreditRekomendasiUpdated KreditRekomendasi[] @relation("KreditRekomendasiUpdatedByUserId")
  kreditRekomendasiDeleted KreditRekomendasi[] @relation("KreditRekomendasiDeletedByUserId")



  @@map("user")
  UserLokasiAbsensi UserLokasiAbsensi[]
}

model UserCabang {
  id        String   @id @default(uuid()) @map("user_cabang_id")
  userId    String   @map("user_id")
  cabangId  String   @map("cabang_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cabang    Cabang   @relation(fields: [cabangId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("user_cabang")
}

model Role {
  id          String              @id @default(uuid()) @map("role_id")
  namaRole    String              @unique @map("nama_role") @db.VarChar(50)
  displayName String              @map("display_name") @db.VarChar(100) @default("")
  deskripsi   String?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")
  status      String          @default("aktif")
  is_system Boolean   @default(false) @map("is_system")
  // Audit fields
  created_by String? @map("created_by") @db.VarChar(36)
  updated_by String? @map("updated_by") @db.VarChar(36)
  deleted_by String? @map("deleted_by") @db.VarChar(36)
  created_by_user_Id String? @map("created_by_user_id") @db.VarChar(36)
  updated_by_user_Id String? @map("updated_by_user_id") @db.VarChar(36)
  deleted_by_user_Id String? @map("deleted_by_user_id") @db.VarChar(36)
  userRoles   UserRole[]
  permissions RolePermission[]
  roleMenus   RoleMenu[]

  @@map("roles")
}

model Permission {
  id             String           @id @default(uuid()) @map("permission_id")
  name           String           @unique @db.VarChar(100)
  description    String?          @db.Text
  module         String           @db.VarChar(50)
  status         String           @default("aktif")
  action         PermissionAction
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  rolePermission RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @map("role_permission_id")
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

enum PermissionAction {
  create
  read
  update
  delete
  manage
}

model UserRole {
  id        String   @id @default(uuid()) @map("user_role_id")
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  cabangId  String   @map("cabang_id")
  assigned_by String? @map("assigned_by") @default("")
  assigned_at DateTime @map("assigned_at") @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cabang    Cabang   @relation(fields: [cabangId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("user_roles")
}

model UserSession {
  id           String    @id @default(uuid()) @map("session_id")
  userId       String    @map("user_id")
  token        String    @db.VarChar(255)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent")
  lastActivity DateTime? @map("last_activity")
  expiredAt    DateTime? @map("expired_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id])

  @@map("user_session")
}

model Kategori {
  id           String         @id @default(uuid()) @map("kategori_id")
  namaKategori String         @unique @map("nama_kategori") @db.VarChar(100)
  deskripsi    String?
  status       KategoriStatus @default(aktif)
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  // Audit fields
  created_by String? @map("created_by") @db.VarChar(36)
  updated_by String? @map("updated_by") @db.VarChar(36)
  deleted_by String? @map("deleted_by") @db.VarChar(36)

  created_by_user_Id String? @map("created_by_user_id") @db.VarChar(36)
  updated_by_user_Id String? @map("updated_by_user_id") @db.VarChar(36)
  deleted_by_user_Id String? @map("deleted_by_user_id") @db.VarChar(36)

  // Relations
  createdByUserId User? @relation("KategoriCreatedByUserId", fields: [created_by_user_Id], references: [id])
  updatedByUserId User? @relation("KategoriUpdatedByUserId", fields: [updated_by_user_Id], references: [id])
  deletedByUserId User? @relation("KategoriDeletedByUserId", fields: [deleted_by_user_Id], references: [id])

  produkMaster      ProdukMaster[]
  ProdukRequestItem ProdukRequestItem[]
  promoDiskon       PromoDiskon[]

  @@map("kategori")
}

model PromoDiskon {
  id              String            @id @default(uuid()) @map("promo_id")
  namaPromo       String            @map("nama_promo") @db.VarChar(100)
  kodePromo       String            @unique @map("kode_promo") @db.VarChar(50)
  tipeDiskon      TipeDiskon        @map("tipe_diskon")
  nilaiDiskon     Decimal           @map("nilai_diskon") @db.Decimal(15, 2)
  minPembelian    Decimal?          @map("min_pembelian") @db.Decimal(15, 2)
  maxDiskon       Decimal?          @map("max_diskon") @db.Decimal(15, 2)
  tanggalMulai    DateTime?         @map("tanggal_mulai") @db.Date
  tanggalBerakhir DateTime?         @map("tanggal_berakhir") @db.Date
  limitPenggunaan Int?              @map("limit_penggunaan")
  kategoriId      String?           @map("kategori_id")
  produkId        String?           @map("produk_id")
  cabangId        String?           @map("cabang_id")
  status          PromoDiskonStatus @default(aktif)
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  cabang          Cabang?           @relation(fields: [cabangId], references: [id])
  kategori        Kategori?         @relation(fields: [kategoriId], references: [id])
  produkMaster    ProdukMaster?     @relation(fields: [produkId], references: [id])
  transaksis      Transaksi[]
  created_by      String?           @map("created_by") @db.VarChar(36)
  updated_by      String?           @map("updated_by") @db.VarChar(36)
  deleted_by      String?           @map("deleted_by") @db.VarChar(36)

  created_by_user_Id String? @map("created_by_user_id") @db.VarChar(36)
  updated_by_user_Id String? @map("updated_by_user_id") @db.VarChar(36)
  deleted_by_user_Id String? @map("deleted_by_user_id") @db.VarChar(36)

  createdByUserId User? @relation("PromoDiskonCreatedByUserId", fields: [created_by_user_Id], references: [id])
  updatedByUserId User? @relation("PromoDiskonUpdatedByUserId", fields: [updated_by_user_Id], references: [id])
  deletedByUserId User? @relation("PromoDiskonDeletedByUserId", fields: [deleted_by_user_Id], references: [id])

  @@map("promo_diskon")
}

model Shift {
  id              String           @id @default(uuid()) @map("shift_id")
  userId          String           @map("user_id")
  cabangId        String           @map("cabang_id")
  waktuMulai      DateTime         @map("waktu_mulai")
  waktuSelesai    DateTime?        @map("waktu_selesai")
  kasAwal         Decimal          @map("kas_awal") @db.Decimal(15, 2)
  kasAkhir        Decimal?         @map("kas_akhir") @db.Decimal(15, 2)
  totalTransaksi  Int?             @map("total_transaksi")
  totalPendapatan Decimal?         @map("total_pendapatan") @db.Decimal(15, 2)
  keterangan      String?
  status          ShiftStatus
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  cabang          Cabang           @relation(fields: [cabangId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  transaksi       Transaksi[]
  absensiPegawai  AbsensiPegawai[]

  created_by String? @map("created_by") @db.VarChar(36)
  updated_by String? @map("updated_by") @db.VarChar(36)
  deleted_by String? @map("deleted_by") @db.VarChar(36)

  deleted_by_user_Id String? @map("deleted_by_user_id") @db.VarChar(36)
  created_by_user_Id String? @map("created_by_user_id") @db.VarChar(36)
  updated_by_user_Id String? @map("updated_by_user_id") @db.VarChar(36)

  createdByUserId User? @relation("ShiftCreatedByUserId", fields: [created_by_user_Id], references: [id])
  updatedByUserId User? @relation("ShiftUpdatedByUserId", fields: [updated_by_user_Id], references: [id])
  deletedByUserId User? @relation("ShiftDeletedByUserId", fields: [deleted_by_user_Id], references: [id])

  @@map("shift")
}

model Supplier {
  id           String         @id @default(uuid()) @map("supplier_id")
  namaSupplier String         @map("nama_supplier") @db.VarChar(100)
  alamat       String?
  telepon      String?        @db.VarChar(20)
  email        String?        @db.VarChar(100)
  npwp         String?        @db.VarChar(50)
  picNama      String?        @map("pic_nama") @db.VarChar(100)
  picKontak    String?        @map("pic_kontak") @db.VarChar(50)
  status       SupplierStatus @default(aktif)
  deletedAt    DateTime?      @map("deleted_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  cabang_id    String?        @db.VarChar(36)

  // Audit fields
  created_by String? @map("created_by") @db.VarChar(36)
  updated_by String? @map("updated_by") @db.VarChar(36)
  deleted_by String? @map("deleted_by") @db.VarChar(36)

  deleted_by_user_Id String? @map("deleted_by_user_id") @db.VarChar(36)
  created_by_user_Id String? @map("created_by_user_id") @db.VarChar(36)
  updated_by_user_Id String? @map("updated_by_user_id") @db.VarChar(36)

  // Relations
  cabang          Cabang? @relation(fields: [cabang_id], references: [id])
  createdByUserId User?   @relation("SupplierCreatedByUserId", fields: [created_by_user_Id], references: [id])
  updatedByUserId User?   @relation("SupplierUpdatedByUserId", fields: [updated_by_user_Id], references: [id])
  deletedByUserId User?   @relation("SupplierDeletedByUserId", fields: [deleted_by_user_Id], references: [id])

  priceHistory   ProdukPriceHistory[]
  produkSupplier ProdukSupplier[]
  transaksi      Transaksi[]
  hutang         Hutang[]

  @@map("supplier")
}

model Pelanggan {
  id            String           @id @default(uuid()) @map("pelanggan_id")
  namaPelanggan String           @map("nama_pelanggan") @db.VarChar(100)
  alamat        String?
  telepon       String?          @db.VarChar(20)
  email         String?          @db.VarChar(100)
  tanggalLahir  DateTime?        @map("tanggal_lahir") @db.Date
  gender        Gender?
  poin          Int?
  segmen        SegmenPelanggan?
  status        PelangganStatus  @default(aktif)
  deletedAt     DateTime?        @map("deleted_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  cabang_id     String?          @db.VarChar(36)

  // Audit fields
  created_by String? @map("created_by") @db.VarChar(36)
  updated_by String? @map("updated_by") @db.VarChar(36)
  deleted_by String? @map("deleted_by") @db.VarChar(36)

  deleted_by_user_Id String? @map("deleted_by_user_id") @db.VarChar(36)
  created_by_user_Id String? @map("created_by_user_id") @db.VarChar(36)
  updated_by_user_Id String? @map("updated_by_user_id") @db.VarChar(36)

  // Relations
  cabang        Cabang? @relation(fields: [cabang_id], references: [id])
  createdByUser User?   @relation("PelangganCreatedByUserId", fields: [created_by_user_Id], references: [id])
  updatedByUser User?   @relation("PelangganUpdatedByUserId", fields: [updated_by_user_Id], references: [id])
  deletedByUser User?   @relation("PelangganDeletedByUserId", fields: [deleted_by_user_Id], references: [id])

  LoyaltyPointHistory         LoyaltyPointHistory[]
  hutang                      Hutang[]
  kreditSettings              KreditSetting[]
  transaksi                   Transaksi[]
  CustomerCampaignInteraction CustomerCampaignInteraction[]
  BotSession                  BotSession[]

  @@map("pelanggan")
  KreditNotifikasi KreditNotifikasi[]
  KreditRekomendasi KreditRekomendasi[]
}

model ProdukMaster {
  id             String             @id @default(uuid()) @map("produk_master_id")
  namaProduk     String             @map("nama_produk") @db.VarChar(100)
  sku            String             @unique @map("sku") @db.VarChar(50)
  barcode        String?            @db.VarChar(50)
  deskripsi      String?
  kategoriId     String?            @map("kategori_id")
  brand          String?            @db.VarChar(100)
  satuan         String?            @db.VarChar(50)
  berat          Decimal?           @db.Decimal(10, 2)
  isi            Int?
  dimensiP       Decimal?           @map("dimensi_p") @db.Decimal(10, 2)
  dimensiL       Decimal?           @map("dimensi_l") @db.Decimal(10, 2)
  dimensiT       Decimal?           @map("dimensi_t") @db.Decimal(10, 2)
  isManagedStock Boolean?           @map("is_managed_stock")
  hasExpired     Boolean?           @map("has_expired")
  status         ProdukMasterStatus @default(aktif)
  deletedAt      DateTime?          @map("deleted_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  // Audit fields
  created_by String? @map("created_by") @db.VarChar(36)
  updated_by String? @map("updated_by") @db.VarChar(36)
