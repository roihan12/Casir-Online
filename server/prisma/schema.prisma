// Marketing Campaign Model
model MarketingCampaign {
  id             String         @id @default(uuid()) @map("campaign_id")
  nama           String         @map("nama_campaign") @db.VarChar(100)
  deskripsi      String?
  tanggalMulai   DateTime       @map("tanggal_mulai")
  tanggalSelesai DateTime?      @map("tanggal_selesai")
  budget         Decimal?       @db.Decimal(15, 2)
  budgetTerpakai Decimal?       @map("budget_terpakai") @db.Decimal(15, 2)
  targetAudience String?        @map("target_audience")
  status         CampaignStatus @default(draft)
  cabangId       String?        @map("cabang_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  created_by String? @map("created_by") @db.VarChar(36)
  updated_by String? @map("updated_by") @db.VarChar(36)
  deleted_by String? @map("deleted_by") @db.VarChar(36)

  deleted_by_user_Id String? @map("deleted_by_user_id") @db.VarChar(36)
  created_by_user_Id String? @map("created_by_user_id") @db.VarChar(36)
  updated_by_user_Id String? @map("updated_by_user_id") @db.VarChar(36)

  createdByUser User? @relation("MarketingCampaignCreatedByUserId", fields: [created_by_user_Id], references: [id])
  updatedByUser User? @relation("MarketingCampaignUpdatedByUserId", fields: [updated_by_user_Id], references: [id])
  deletedByUser User? @relation("MarketingCampaignDeletedByUserId", fields: [deleted_by_user_Id], references: [id])

  cabang       Cabang?                       @relation(fields: [cabangId], references: [id])
  channels     MarketingChannel[]
  contents     MarketingContent[]
  analytics    CampaignAnalytics[]
  interactions CustomerCampaignInteraction[]
  transaksi    Transaksi[]                   @relation("CampaignTransaksi")

  @@map("marketing_campaign")
}

// Marketing Channel Model
model MarketingChannel {
  id           String      @id @default(uuid()) @map("channel_id")
  campaignId   String      @map("campaign_id")
  tipeChannel  ChannelType
  namaChannel  String      @map("nama_channel") @db.VarChar(100)
  accountInfo  String?     @map("account_info")
  accessToken  String?     @map("access_token")
  refreshToken String?     @map("refresh_token")
  tokenExpiry  DateTime?   @map("token_expiry")
  metrics      Json?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  campaign MarketingCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contents MarketingContent[]

  @@map("marketing_channel")
}

// Marketing Content Model
model MarketingContent {
  id                String        @id @default(uuid()) @map("content_id")
  campaignId        String        @map("campaign_id")
  channelId         String        @map("channel_id")
  judul             String?       @db.VarChar(200)
  konten            String?
  imageUrl          String?       @map("image_url")
  videoUrl          String?       @map("video_url")
  contentType       ContentType   @map("content_type")
  jadwalPublish     DateTime?     @map("jadwal_publish")
  isPublished       Boolean       @default(false) @map("is_published")
  publishedAt       DateTime?     @map("published_at")
  externalContentId String?       @map("external_content_id")
  status            ContentStatus @default(draft)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  created_by        String?       @map("created_by") @db.VarChar(36)
  updated_by        String?       @map("updated_by") @db.VarChar(36)
  deleted_by        String?       @map("deleted_by") @db.VarChar(36)

  deleted_by_user_Id String? @map("deleted_by_user_id") @db.VarChar(36)
  created_by_user_Id String? @map("created_by_user_id") @db.VarChar(36)
  updated_by_user_Id String? @map("updated_by_user_id") @db.VarChar(36)

  createdByUser User? @relation("MarketingContentCreatedByUserId", fields: [created_by_user_Id], references: [id])
  updatedByUser User? @relation("MarketingContentUpdatedByUserId", fields: [updated_by_user_Id], references: [id])
  deletedByUser User? @relation("MarketingContentDeletedByUserId", fields: [deleted_by_user_Id], references: [id])

  campaign  MarketingCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channel   MarketingChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  analytics ContentAnalytics[]

  @@map("marketing_content")
}

// Campaign Analytics Model
model CampaignAnalytics {
  id          String   @id @default(uuid()) @map("analytics_id")
  campaignId  String   @map("campaign_id")
  impressions Int?
  clicks      Int?
