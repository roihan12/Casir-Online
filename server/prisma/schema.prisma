  scheduledTime    DateTime? @map("scheduled_time")
  estimatedArrival DateTime? @map("estimated_arrival")

  // Informasi kurir (jika diantar)
  courierName  String? @map("courier_name") @db.VarChar(100)
  courierPhone String? @map("courier_phone") @db.VarChar(20)
  courierNotes String? @map("courier_notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  session   BotSession @relation(fields: [sessionId], references: [id])
  botConfig BotConfig  @relation(fields: [botConfigId], references: [id])
  transaksi Transaksi? @relation(fields: [transaksiId], references: [transaksi_id])

  @@map("bot_order")
}

// Tambahkan enum untuk metode pengiriman
enum DeliveryMethod {
  pickup // Diambil di toko
  delivery // Diantar ke alamat pelanggan
}

// Bot Configuration Model
model BotConfig {
  id              String       @id @default(uuid()) @map("bot_config_id")
  cabangId        String       @map("cabang_id")
  platformType    PlatformType @map("platform_type")
  isActive        Boolean      @default(true) @map("is_active")
  apiKey          String?      @map("api_key") @db.VarChar(255)
  apiSecret       String?      @map("api_secret") @db.VarChar(255)
  phoneNumber     String?      @map("phone_number") @db.VarChar(20)
  webhookUrl      String?      @map("webhook_url") @db.VarChar(255)
  welcomeMessage  String?      @map("welcome_message") @db.Text
  catalogMessage  String?      @map("catalog_message") @db.Text
  orderMessage    String?      @map("order_message") @db.Text
  thankYouMessage String?      @map("thank_you_message") @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  cabang       Cabang        @relation(fields: [cabangId], references: [id])
  botSessions  BotSession[]
  botTemplates BotTemplate[]
  botOrders    BotOrder[]

  @@map("bot_config")
}

// Bot Message Templates
model BotTemplate {
  id              String       @id @default(uuid()) @map("template_id")
  botConfigId     String       @map("bot_config_id")
  templateName    String       @map("template_name") @db.VarChar(100)
  templateContent String       @map("template_content") @db.Text
  templateType    TemplateType @map("template_type")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  botConfig BotConfig @relation(fields: [botConfigId], references: [id], onDelete: Cascade)

  @@map("bot_template")
}

// Bot Customer Session
model BotSession {
  id              String        @id @default(uuid()) @map("session_id")
  botConfigId     String        @map("bot_config_id")
  pelangganId     String?       @map("pelanggan_id")
  platformUserId  String        @map("platform_user_id") @db.VarChar(100)
  sessionData     Json?         @map("session_data")
  cartData        Json?         @map("cart_data")
  lastInteraction DateTime      @map("last_interaction")
  sessionStatus   SessionStatus @default(active) @map("session_status")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  botConfig   BotConfig    @relation(fields: [botConfigId], references: [id], onDelete: Cascade)
  pelanggan   Pelanggan?   @relation(fields: [pelangganId], references: [id])
  botMessages BotMessage[]
  botOrders   BotOrder[]

  @@map("bot_session")
}

// Bot Message History
model BotMessage {
  id             String      @id @default(uuid()) @map("message_id")
  sessionId      String      @map("session_id")
  messageType    MessageType @map("message_type")
  messageContent String      @map("message_content") @db.Text
  mediaUrl       String?     @map("media_url") @db.VarChar(255)
  isFromBot      Boolean     @default(true) @map("is_from_bot")
  timestamp      DateTime    @default(now())

  session BotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("bot_message")
}

// Enums for Bot Features
enum PlatformType {
  whatsapp
  telegram
  messenger
}

enum TemplateType {
  welcome
  catalog
  product
  cart
  checkout
  order_confirmation
  payment
  delivery
  custom
}

enum MessageType {
  text
  image
  document
  location
  contact
  interactive
  template
  button
}

enum SessionStatus {
  active
  idle
  completed
  abandoned
}

enum OrderStatus {
  pending
  confirmed
  processing
  completed
  cancelled
  failed
}

model LoyaltyConfig {
  id                 String   @id @default(uuid()) @map("loyalty_config_id")
  cabangId           String?  @map("cabang_id") @db.VarChar(36)
  pointRate          Int      @default(10000) @map("point_rate")
  minimumTransaction Decimal? @map("minimum_transaction") @db.Decimal(15, 2)
  expiryDays         Int?     @map("expiry_days")
  isActive           Boolean  @default(true) @map("is_active")
  redeemRules        Json?    @map("redeem_rules")
  tierRules          Json?    @map("tier_rules")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  cabang Cabang? @relation(fields: [cabangId], references: [id])

  @@map("loyalty_config")
}


model KreditRekomendasi {
  id                String                @id @default(uuid()) @map("kredit_rekomendasi_id")
  pelangganId       String                @map("pelanggan_id")
  skorKredit        Int                   @map("skor_kredit") // 0-100 scale
  limitKredit       Decimal               @map("limit_kredit") @db.Decimal(15, 2)
  tenorMaksimal     Int                   @map("tenor_maksimal")
  bungaPerBulan     Decimal?              @map("bunga_per_bulan") @db.Decimal(5, 2)
  biayaAdmin        Decimal?              @map("biaya_admin") @db.Decimal(15, 2)
  statusPersetujuan StatusPersetujuan     @default(pending) @map("status_persetujuan")
  disetujuiOleh     String?               @map("disetujui_oleh")
  tanggalDisetujui  DateTime?             @map("tanggal_disetujui")
  keterangan        String?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  created_by        String?               @map("created_by") @db.VarChar(36)
  updated_by        String?               @map("updated_by") @db.VarChar(36)
  deleted_by        String?               @map("deleted_by") @db.VarChar(36)
  
  deleted_by_user_Id String? @map("deleted_by_user_id") @db.VarChar(36)
  created_by_user_Id String? @map("created_by_user_id") @db.VarChar(36)
  updated_by_user_Id String? @map("updated_by_user_id") @db.VarChar(36)
  
  createdByUser User? @relation("KreditRekomendasiCreatedByUserId", fields: [created_by_user_Id], references: [id])
  updatedByUser User? @relation("KreditRekomendasiUpdatedByUserId", fields: [updated_by_user_Id], references: [id])
  deletedByUser User? @relation("KreditRekomendasiDeletedByUserId", fields: [deleted_by_user_Id], references: [id])
  
  pelanggan        Pelanggan                @relation(fields: [pelangganId], references: [id])
  approvedBy       User?                    @relation("ApprovedKreditRekomendasi", fields: [disetujuiOleh], references: [id])
  opsiPembayaran   OpsiPembayaranKredit[]
  
  @@map("kredit_rekomendasi")
}

model OpsiPembayaranKredit {
  id                  String            @id @default(uuid()) @map("opsi_pembayaran_id")
  rekomendasiId       String            @map("rekomendasi_id")
  jangkaWaktu         Int               @map("jangka_waktu") // in days
  jumlahCicilan       Int?              @map("jumlah_cicilan")
  minimumBayar        Decimal?          @map("minimum_bayar") @db.Decimal(15, 2)
  bungaPerBulan       Decimal?          @map("bunga_per_bulan") @db.Decimal(5, 2)
  biayaAdmin          Decimal?          @map("biaya_admin") @db.Decimal(15, 2)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  
  rekomendasi         KreditRekomendasi @relation(fields: [rekomendasiId], references: [id], onDelete: Cascade)
  
  @@map("opsi_pembayaran_kredit")
}

enum StatusPersetujuan {
  pending
  disetujui
  ditolak
}

// Model untuk absensi pegawai
model AbsensiPegawai {
  id                String            @id @default(uuid()) @map("absensi_id")
  userId            String            @map("user_id")
  cabangId          String            @map("cabang_id")
  lokasiAbsensiId   String?           @map("lokasi_absensi_id") // ID lokasi absensi fleksibel
  tanggalAbsensi    DateTime          @map("tanggal_absensi") @db.Date
  waktuMasuk        DateTime          @map("waktu_masuk")
  waktuKeluar       DateTime?         @map("waktu_keluar")
  statusKehadiran   StatusKehadiran   @default(hadir)
  keterangan        String?           @db.Text
  lokasiMasuk       String?           @map("lokasi_masuk")
  lokasiKeluar      String?           @map("lokasi_keluar")
  latitudeMasuk     Decimal?          @map("latitude_masuk") @db.Decimal(10, 8)
  longitudeMasuk    Decimal?          @map("longitude_masuk") @db.Decimal(11, 8)
  latitudeKeluar    Decimal?          @map("latitude_keluar") @db.Decimal(10, 8)
  longitudeKeluar   Decimal?          @map("longitude_keluar") @db.Decimal(11, 8)
  fotoMasuk         String?           @map("foto_masuk") // URL foto untuk absensi masuk
  fotoKeluar        String?           @map("foto_keluar") // URL foto untuk absensi keluar
  faceRecognitionMasuk Boolean         @default(false) @map("face_recognition_masuk") // Flag jika absensi masuk menggunakan face recognition
  faceRecognitionKeluar Boolean        @default(false) @map("face_recognition_keluar") // Flag jika absensi keluar menggunakan face recognition
  faceMatchScoreMasuk Decimal?        @map("face_match_score_masuk") @db.Decimal(5, 2) // Skor kecocokan wajah saat masuk (0-100)
  faceMatchScoreKeluar Decimal?       @map("face_match_score_keluar") @db.Decimal(5, 2) // Skor kecocokan wajah saat keluar (0-100)
  shiftId           String?           @map("shift_id")
  jamKerja          Decimal?          @map("jam_kerja") @db.Decimal(5, 2)
  isLembur          Boolean           @default(false) @map("is_lembur")
  jamLembur         Decimal?          @map("jam_lembur") @db.Decimal(5, 2)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  
  // Relations
  user              User              @relation(fields: [userId], references: [id])
  cabang            Cabang            @relation(fields: [cabangId], references: [id])
  lokasiAbsensi     LokasiAbsensi?    @relation(fields: [lokasiAbsensiId], references: [id])
  shift             Shift?            @relation(fields: [shiftId], references: [id])
  
  @@map("absensi_pegawai")
}

// Model untuk jadwal kerja pegawai
model JadwalKerja {
  id                String            @id @default(uuid()) @map("jadwal_id")
  userId            String            @map("user_id")
  cabangId          String            @map("cabang_id")
  tanggalMulai      DateTime          @map("tanggal_mulai") @db.Date
  tanggalSelesai    DateTime          @map("tanggal_selesai") @db.Date
  jamMasuk          String            @map("jam_masuk") // Format: "HH:mm"
  jamKeluar         String            @map("jam_keluar") // Format: "HH:mm"
  hariKerja         String[]          @map("hari_kerja") // Array of days: ["Senin", "Selasa", ...]
  keterangan        String?           @db.Text
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  created_by        String?           @map("created_by") @db.VarChar(36)
  updated_by        String?           @map("updated_by") @db.VarChar(36)
  
  // Relations
  user              User              @relation(fields: [userId], references: [id])
  cabang            Cabang            @relation(fields: [cabangId], references: [id])
  
  @@map("jadwal_kerja")
}

// Enum untuk status kehadiran
enum StatusKehadiran {
  hadir
  terlambat
  izin
  sakit
  cuti
  tanpa_keterangan
  lembur
}

// Model untuk lokasi absensi yang fleksibel
model LokasiAbsensi {
  id                String            @id @default(uuid()) @map("lokasi_id")
  nama              String            @map("nama_lokasi") @db.VarChar(100)
  alamat            String?           @db.Text
  latitude          Decimal           @db.Decimal(10, 8)
  longitude         Decimal           @db.Decimal(11, 8)
  radius            Int               @default(100) @map("radius") // dalam meter
  isActive          Boolean           @default(true) @map("is_active")
  // Face Recognition Settings
  requireFaceRecognition Boolean      @default(false) @map("require_face_recognition") // Apakah wajib face recognition di lokasi ini
  minFaceMatchScore Decimal?         @map("min_face_match_score") @db.Decimal(5, 2) // Skor minimum kecocokan wajah (0-100)
  cabangId          String?           @map("cabang_id") // Opsional, bisa tidak terkait dengan cabang
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  created_by        String?           @map("created_by") @db.VarChar(36)
  updated_by        String?           @map("updated_by") @db.VarChar(36)
  
  // Relations
  cabang            Cabang?           @relation(fields: [cabangId], references: [id])
  userLokasiAbsensi UserLokasiAbsensi[]
  absensiPegawai    AbsensiPegawai[]
  
  @@map("lokasi_absensi")
}

// Model untuk menghubungkan user dengan lokasi absensi yang diizinkan
model UserLokasiAbsensi {
  id                String            @id @default(uuid()) @map("user_lokasi_id")
  userId            String            @map("user_id")
  lokasiId          String            @map("lokasi_id")
  isDefault         Boolean           @default(false) @map("is_default")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  
  // Relations
  user              User              @relation(fields: [userId], references: [id])
  lokasi            LokasiAbsensi     @relation(fields: [lokasiId], references: [id])
  
  @@unique([userId, lokasiId])
  @@map("user_lokasi_absensi")
  Cabang Cabang[]
}

// Model untuk menu aplikasi
model Menu {
  id          String      @id @default(uuid()) @map("menu_id")
  name        String      @map("menu_name") @db.VarChar(100)
  path        String?     @db.VarChar(255)
  icon        String?     @db.VarChar(100)
  parentId    String?     @map("parent_id")
  orderIndex  Int         @default(0) @map("order_index")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  createdBy   String?     @map("created_by")
  updatedBy   String?     @map("updated_by")
  
  // Relations
  parent      Menu?       @relation("MenuHierarchy", fields: [parentId], references: [id])
  children    Menu[]      @relation("MenuHierarchy")
  roleMenus   RoleMenu[]
  
  @@map("menu")
}

// Model untuk menghubungkan role dengan menu dan izin akses
model RoleMenu {
  id        String    @id @default(uuid()) @map("role_menu_id")
  roleId    String    @map("role_id")
  menuId    String    @map("menu_id")
  canView   Boolean   @default(true) @map("can_view")
  canCreate Boolean   @default(false) @map("can_create")
  canEdit   Boolean   @default(false) @map("can_edit")
  canDelete Boolean   @default(false) @map("can_delete")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  
  // Relations
  role      Role      @relation(fields: [roleId], references: [id])
  menu      Menu      @relation(fields: [menuId], references: [id])
  
  @@unique([roleId, menuId])
  @@map("role_menu")
}