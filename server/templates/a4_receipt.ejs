<!-- File: src/templates/a4_receipt.ejs -->
<!DOCTYPE html>
<html lang="<%= options.language %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Receipt <%= number %></title>
  <style>
    /* Base styles for A4 receipt */
    body {
      font-family: Arial, sans-serif;
      font-size: <%= receiptConfig.fontSize || 12 %>px;
      width: 210mm;
      margin: 0 auto;
      padding: 10mm;
      box-sizing: border-box;
      line-height: 1.3;
    }
    
    .receipt-container {
      width: 100%;
      max-width: 190mm;
      margin: 0 auto;
    }
    
    .header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    
    .company-info {
      flex: 1;
    }
    
    .logo-container {
      text-align: right;
      flex: 1;
    }
    
    .logo {
      max-width: 150px;
      max-height: 80px;
    }
    
    .company-name {
      font-size: 1.5em;
      font-weight: bold;
      margin: 5px 0;
    }
    
    .contact-info {
      margin-bottom: 5px;
    }
    
    .receipt-title {
      text-align: center;
      font-size: 1.3em;
      font-weight: bold;
      margin: 20px 0;
      text-transform: uppercase;
    }
    
    .info-section {
      display: flex;
      justify-content: space-between;
      margin: 20px 0;
    }
    
    .transaction-info, .customer-info {
      flex: 1;
    }
    
    .divider {
      border-top: 1px solid #ccc;
      margin: 10px 0;
    }
    
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
    }
    
    .items-table th, .items-table td {
      padding: 8px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    
    .items-table th {
      background-color: #f5f5f5;
      font-weight: bold;
    }
    
    .amount-column {
      text-align: right;
    }
    
    .summary {
      width: 50%;
      margin-left: auto;
      margin-top: 20px;
      border-collapse: collapse;
    }
    
    .summary td {
      padding: 5px;
    }
    
    .summary-label {
      text-align: left;
    }
    
    .summary-value {
      text-align: right;
      font-weight: normal;
    }
    
    .summary-total {
      font-weight: bold;
      border-top: 1px solid #000;
    }
    
    .payment-info {
      margin: 20px 0;
    }
    
    .payment-table {
      width: 50%;
      margin-left: auto;
      border-collapse: collapse;
    }
    
    .payment-table td {
      padding: 5px;
    }
    
    .footer {
      text-align: center;
      margin-top: 40px;
    }
    
    .thank-you {
      font-weight: bold;
      font-size: 1.1em;
      margin: 10px 0;
    }
    
    .notes {
      margin: 20px 0;
      padding: 10px;
      border: 1px solid #ddd;
      background-color: #f9f9f9;
    }
    
    .qr-section {
      display: flex;
      justify-content: center;
      margin: 20px 0;
    }
    
    .qr-code {
      text-align: center;
    }
    
    .qr-code img {
      max-width: 100px;
      max-height: 100px;
    }
    
    /* Add custom CSS if provided */
    <%= receiptConfig.customCss || '' %>
  </style>
</head>
<body>
  <div class="receipt-container">
    <% if (options.includeHeader) { %>
    <div class="header">
      <div class="company-info">
        <h1 class="company-name"><%= receiptConfig.headerText %></h1>
        <% if (branchAddress) { %>
        <div class="contact-info"><%= branchAddress %></div>
        <% } %>
        <% if (branchPhone) { %>
        <div class="contact-info">Tel: <%= branchPhone %></div>
        <% } %>
      </div>
      <% if (options.includeLogo && receiptConfig.logoUrl) { %>
      <div class="logo-container">
        <img class="logo" src="<%= receiptConfig.logoUrl %>" alt="<%= branchName %> Logo">
      </div>
      <% } %>
    </div>
    <% } %>
    
    <h2 class="receipt-title"><%= translations[options.language].receipt %></h2>
    
    <div class="info-section">
      <div class="transaction-info">
        <p><strong><%= translations[options.language].date %>:</strong> <%= formatDate(date) %></p>
        <p><strong>Receipt No:</strong> <%= number %></p>
        <% if (receiptConfig.showCashierName) { %>
        <p><strong><%= translations[options.language].cashier %>:</strong> <%= cashierName %></p>
        <% } %>
      </div>
      <% if (customerInfo) { %>
      <div class="customer-info">
        <p><strong><%= translations[options.language].customer %>:</strong> <%= customerInfo.name %></p>
        <% if (customerInfo.contact) { %>
        <p><strong>Contact:</strong> <%= customerInfo.contact %></p>
        <% } %>
      </div>
      <% } %>
    </div>
    
    <div class="divider"></div>
    
    <table class="items-table">
      <thead>
        <tr>
          <th width="5%">No</th>
          <th width="45%"><%= translations[options.language].item %></th>
          <th width="10%"><%= translations[options.language].qty %></th>
          <th width="15%" class="amount-column"><%= translations[options.language].price %></th>
          <th width="10%" class="amount-column"><%= translations[options.language].discount %></th>
          <th width="15%" class="amount-column"><%= translations[options.language].subtotal %></th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach((item, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= item.name %></td>
          <td><%= item.quantity %></td>
          <td class="amount-column"><%= formatCurrency(item.price) %></td>
          <td class="amount-column"><%= item.discount > 0 ? formatCurrency(item.discount) : '-' %></td>
          <td class="amount-column"><%= formatCurrency(item.subtotal) %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    
    <table class="summary">
      <tr>
        <td class="summary-label"><%= translations[options.language].subtotal %>:</td>
        <td class="summary-value"><%= formatCurrency(subtotal) %></td>
      </tr>
      <% if (discount > 0) { %>
      <tr>
        <td class="summary-label"><%= translations[options.language].discount %>:</td>
        <td class="summary-value">-<%= formatCurrency(discount) %></td>
      </tr>
      <% } %>
      <% if (receiptConfig.showTaxDetails && tax > 0) { %>
      <tr>
        <td class="summary-label"><%= translations[options.language].tax %>:</td>
        <td class="summary-value"><%= formatCurrency(tax) %></td>
      </tr>
      <% } %>
      <% if (additionalFee > 0) { %>
      <tr>
        <td class="summary-label">Additional Fee:</td>
        <td class="summary-value"><%= formatCurrency(additionalFee) %></td>
      </tr>
      <% } %>
      <tr class="summary-total">
        <td class="summary-label"><strong><%= translations[options.language].total %>:</strong></td>
        <td class="summary-value"><strong><%= formatCurrency(total) %></strong></td>
      </tr>
    </table>
    
    <div class="payment-info">
      <h3>Payment Information</h3>
      <table class="payment-table">
        <% payments.forEach(payment => { %>
        <tr>
          <td class="summary-label"><%= payment.method %><%= payment.provider ? ' (' + payment.provider + ')' : '' %>:</td>
          <td class="summary-value"><%= formatCurrency(payment.amount) %></td>
        </tr>
        <% if (payment.change > 0) { %>
        <tr>
          <td class="summary-label"><%= translations[options.language].change %>:</td>
          <td class="summary-value"><%= formatCurrency(payment.change) %></td>
        </tr>
        <% } %>
        <% if (payment.reference) { %>
        <tr>
          <td colspan="2">Reference: <%= payment.reference %></td>
        </tr>
        <% } %>
        <% }); %>
      </table>
    </div>
    
    <% if (notes) { %>
    <div class="notes">
      <strong>Notes:</strong>
      <p><%= notes %></p>
    </div>
    <% } %>
    
    <% if (options.includeFooter) { %>
    <% if (receiptConfig.showQrCode && qrCode) { %>
    <div class="qr-section">
      <div class="qr-code">
        <img src="<%= qrCode %>" alt="QR Code">
        <p>Scan to verify receipt</p>
      </div>
    </div>
    <% } %>
    
    <div class="footer">
      <div class="thank-you">
        <%= receiptConfig.thankYouMessage || translations[options.language].thankYou %>
      </div>
      <div><%= receiptConfig.footerText %></div>
    </div>
    <% } %>
  </div>
</body>
</html>