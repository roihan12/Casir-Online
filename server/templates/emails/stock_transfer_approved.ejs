<!DOCTYPE html>
<html lang="<%= language || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Stock Transfer Approved</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      background-color: #f9fafb;
    }
    .email-container {
      background-color: #ffffff;
      border-radius: 8px;
      padding: 30px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
    .header {
      text-align: center;
      padding-bottom: 20px;
      border-bottom: 2px solid #10b981;
      margin-bottom: 20px;
    }
    .header h1 {
      color: #10b981;
      margin: 0;
      font-size: 24px;
    }
    .header p {
      color: #6b7280;
      margin: 5px 0 0 0;
      font-size: 14px;
    }
    .content {
      margin: 20px 0;
    }
    .info-box {
      background-color: #f3f4f6;
      border-left: 4px solid #10b981;
      padding: 15px;
      margin: 15px 0;
      border-radius: 4px;
    }
    .info-box strong {
      color: #1f2937;
      display: block;
      margin-bottom: 5px;
    }
    .info-box span {
      color: #4b5563;
    }
    .success-message {
      background-color: #ecfdf5;
      border: 1px solid #10b981;
      border-radius: 6px;
      padding: 15px;
      margin: 20px 0;
      text-align: center;
    }
    .success-message p {
      margin: 5px 0;
      color: #065f46;
      font-weight: 500;
    }
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
    }
    .items-table th {
      background-color: #10b981;
      color: white;
      padding: 10px;
      text-align: left;
      font-weight: 600;
    }
    .items-table td {
      padding: 10px;
      border-bottom: 1px solid #e5e7eb;
    }
    .items-table tr:nth-child(even) {
      background-color: #f9fafb;
    }
    .footer {
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid #e5e7eb;
      text-align: center;
      font-size: 12px;
      color: #6b7280;
    }
    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
    }
    .badge-approved {
      background-color: #d1fae5;
      color: #065f46;
    }
  </style>
</head>
<body>
  <div class="email-container">
    <div class="header">
      <h1>Stock Transfer Approved</h1>
      <p><%= companyName || 'Casir Online POS' %></p>
    </div>

    <div class="content">
      <p>Dear Team,</p>

      <div class="success-message">
        <p>Good news! Your stock transfer request has been approved.</p>
      </div>

      <div class="info-box">
        <strong>Transfer Number:</strong>
        <span><%= transfer.nomorTransfer %></span>
      </div>

      <div class="info-box">
        <strong>From Branch:</strong>
        <span><%= transfer.cabangAsal?.namaCabang || 'N/A' %></span>
      </div>

      <div class="info-box">
        <strong>To Branch:</strong>
        <span><%= transfer.cabangTujuan?.namaCabang || 'N/A' %></span>
      </div>

      <div class="info-box">
        <strong>Approved Date:</strong>
        <span><%= formatDate(transfer.tanggalApproved) %></span>
      </div>

      <div class="info-box">
        <strong>Status:</strong>
        <span class="badge badge-approved"><%= transfer.status %></span>
      </div>

      <% if (transfer.approvedBy) { %>
      <div class="info-box">
        <strong>Approved By:</strong>
        <span><%= transfer.approvedBy.namaLengkap || 'Admin' %></span>
      </div>
      <% } %>

      <% if (transfer.catatanApproval) { %>
      <div class="info-box">
        <strong>Approval Notes:</strong>
        <span><%= transfer.catatanApproval %></span>
      </div>
      <% } %>

      <h3>Transfer Items:</h3>
      <table class="items-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>SKU</th>
            <th style="text-align: center;">Quantity</th>
          </tr>
        </thead>
        <tbody>
          <% transfer.items.forEach((item) => { %>
          <tr>
            <td><%= item.produk?.produkMaster?.namaProduk || 'N/A' %></td>
            <td><%= item.produk?.produkMaster?.sku || '-' %></td>
            <td style="text-align: center;"><%= item.jumlah %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>

      <p style="margin-top: 30px;">Please proceed with the shipping arrangements. The receiving branch has been notified to expect the delivery.</p>

      <p>Update the transfer status once the items have been shipped and received.</p>
    </div>

    <div class="footer">
      <p>This is an automated notification from <%= companyName || 'Casir Online POS' %>.</p>
      <p>Please do not reply to this email.</p>
      <p>&copy; <%= new Date().getFullYear() %> <%= companyName || 'Casir Online POS' %>. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
