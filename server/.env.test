# Test Environment Configuration
# This file is used when running tests with Vitest + Testcontainers

NODE_ENV=test
LOG_LEVEL=error

# Test Database - Will be OVERRIDDEN by Testcontainers
# Testcontainers will set process.env.DATABASE_URL automatically
DATABASE_URL="postgresql://test:test@localhost:5432/test"
DIRECT_URL="postgresql://test:test@localhost:5432/test"

# Test Redis - Use local test Redis or mock
REDIS_URL=redis://localhost:6379/1

# Test Configuration
JWT_SECRET=test_jwt_secret_for_testing_only
JWT_EXPIRES_IN=1h

# Test Services - Mock or use test instances
WHATSAPP_SERVICE_URL=http://localhost:5000
WHATSAPP_WEBHOOK_SECRET=test_webhook_secret
WHATSAPP_BASIC_AUTH_USERNAME=admin
WHATSAPP_BASIC_AUTH_PASSWORD=admin

FACE_RECOGNITION_SERVICE_URL=http://localhost:8001

# Midtrans Sandbox
MIDTRANS_SERVER_KEY=SB-Mid-server-TEST
MIDTRANS_CLIENT_KEY=SB-Mid-client-TEST
MIDTRANS_IS_PRODUCTION=false

# Disable external services in tests
ENABLE_SCHEDULERS=false
SEND_EMAILS=false

# Test Gemini API (optional - can be mocked)
GEMINI_API_KEY=test_key

# Sentry - Disable in tests
SENTRY_DSN=

# CORS for testing
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
