# Casir-Online Production Environment Configuration
# Copy this file to .env.production and update with your actual values

# ====================
# Application Settings
# ====================
NODE_ENV=production
LOG_LEVEL=info

# ====================
# Database Configuration
# ====================
# Option 1: Supabase Cloud (Recommended)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Option 2: Local PostgreSQL (uncomment if using local database)
# DATABASE_URL="postgresql://postgres:your_secure_password@postgres:5432/casir"
# DIRECT_URL="postgresql://postgres:your_secure_password@postgres:5432/casir"
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_secure_password_here_change_this
# POSTGRES_DB=casir

# ====================
# Redis Configuration
# ====================
REDIS_URL=redis://:your_redis_password@redis:6379

# ====================
# JWT Configuration
# ====================
# Generate a secure JWT secret with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_USE_OPENSSL_RAND_BASE64_64
JWT_EXPIRES_IN=1d

# ====================
# Midtrans Payment Gateway
# ====================
MIDTRANS_SERVER_KEY=SB-MID-SERVER-XXXXX
MIDTRANS_CLIENT_KEY=SB-MID-CLIENT-XXXXX

# ====================
# Google Gemini API
# ====================
GEMINI_API_KEY=your_gemini_api_key_here

# ====================
# WhatsApp Service Configuration
# ====================
WHATSAPP_SERVICE_URL=http://whatsapp:5000
WHATSAPP_WEBHOOK_SECRET=change_this_to_a_secure_random_string
WHATSAPP_BASIC_AUTH_USERNAME=admin
WHATSAPP_BASIC_AUTH_PASSWORD=change_this_to_a_secure_password

# ====================
# Face Recognition Service
# ====================
FACE_RECOGNITION_SERVICE_URL=http://face-recognition:8001

# ====================
# Email Configuration (SMTP)
# ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@casir.local

# ====================
# Frontend Configuration
# ====================
VITE_API_BASE_URL=https://casir.local/api

# ====================
# Monitoring & Observability
# ====================
# Sentry (Error Tracking) - Optional
# Get your DSN from https://sentry.io
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_secure_password

# ====================
# External Services
# ====================
# Supabase (if using)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# ====================
# File Upload Configuration
# ====================
UPLOAD_MAX_SIZE=20971520
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=400

# ====================
# Session Configuration
# ====================
SESSION_SECRET=change_this_to_another_secure_random_string
SESSION_MAX_AGE=86400000

# ====================
# CORS Configuration
# ====================
ALLOWED_ORIGINS=https://casir.local,https://www.casir.local

# ====================
# Logging Configuration
# ====================
LOG_LEVEL=info
LOG_FILE_PATH=/var/log/casir
LOG_MAX_SIZE=20971520
LOG_MAX_FILES=5

# ====================
# Backup Configuration
# ====================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ====================
# Feature Flags
# ====================
FEATURE_FACE_RECOGNITION=true
FEATURE_WHATSAPP_INTEGRATION=true
FEATURE_ONLINE_ORDERS=true
FEATURE_AI_CHAT=true

# ====================
# Development/Debug
# ====================
DEBUG=false
VERBOSE_LOGGING=false
